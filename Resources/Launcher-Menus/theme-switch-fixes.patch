+static bool isPNGAt(SceUID fd, SceOff offset){
+    static const u8 signature[8] = {0x89, 'P', 'N', 'G', '\r', '\n', 0x1A, '\n'};
+    u8 header[16];
+    sceIoLseek(fd, offset, PSP_SEEK_SET);
+    return sceIoRead(fd, header, sizeof(header)) == sizeof(header)
+        && memcmp(header, signature, sizeof(signature)) == 0
+        && memcmp(header+12, "IHDR", 4) == 0;
+}
+
+bool common::isThemeValid(const char* path){
+    // everything loadTheme() needs: a missing one locks the launcher in the missing file screen,
+    // one that is not a PNG (e.g. a renamed JPEG) loads as a NULL texture that gets dereferenced
+    static const char* required[] = {
+        "WAIT.PNG", "SPRITE.PNG", "NOICON.PNG", "GAME.PNG", "FTP.PNG", "SETTINGS.PNG",
+        "BROWSER.PNG", "BOX.PNG", "EXIT.PNG", "PLUGINS.PNG", "FOLDER.PNG", "FILE.PNG",
+        "TXT.PNG", "PBP.PNG", "PRX.PNG", "ISO.PNG", "ZIP.PNG", "MUSIC.PNG", "PICTURE.PNG",
+        "CHECK.PNG", "UNCHECK.PNG",
+    };
+    SceUID fd = sceIoOpen(path, PSP_O_RDONLY, 0777);
+    if (fd < 0)
+        return false;
+    bool valid = true;
+    for (int i=0; valid && i<(int)(sizeof(required)/sizeof(required[0])); i++){
+        SceOff offset = findPkgOffset(required[i], NULL, path, dummyMissingHandler);
+        valid = offset != 0 && isPNGAt(fd, offset);
+    }
+    if (valid){
+        // same order loadTheme() picks the background in, it must end up with one
+        SceIoStat stat;
+        string custom_path1 = string(ark_config.arkpath) + "BG.JPG";
+        string custom_path2 = string(ark_config.arkpath) + "BG.PNG";
+        SceOff bg_offset = 0;
+        valid = sceIoGetstat(custom_path1.c_str(), &stat) >= 0
+            || sceIoGetstat(custom_path2.c_str(), &stat) >= 0
+            || findPkgOffset("DEFBG.JPG", NULL, path, dummyMissingHandler) != 0
+            || ((bg_offset = findPkgOffset("DEFBG.PNG", NULL, path, dummyMissingHandler)) != 0 && isPNGAt(fd, bg_offset));
+    }
+    sceIoClose(fd);
+    return valid;
+}
