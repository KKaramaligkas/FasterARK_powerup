+void GameManager::stopForThemeChange(){
+    if (self == NULL) return;
+    if (self->dynamicIconRunning == ICONS_PAUSED){
+        // let the thread get past the semaphore so it can see the stop request
+        for (int i=0; i<MAX_CATEGORIES; i++)
+            self->categories[i]->resumeIconLoading();
+        sceKernelSignalSema(self->iconSema, 1);
+    }
+    // wait for it to leave loadIconsDynamic()/findEntries(), it must not create entries with the old images
+    self->endAllThreads();
+    SystemMgr::pauseDraw();
+    self->selectedCategory = -1;
+    for (int i=0; i<MAX_CATEGORIES; i++){
+        self->categories[i]->clearEntries();
+    }
+    SystemMgr::resumeDraw();
+}
+
+void GameManager::restartAfterThemeChange(){
+    if (self == NULL) return;
+    self->selectedCategory = -1; // rescan
+    self->dynamicIconRunning = ICONS_LOADING;
+    self->iconThread = sceKernelCreateThread("icon0_thread", GameManager::loadIcons, 0x10, 0x2000, PSP_THREAD_ATTR_USER|PSP_THREAD_ATTR_VFPU, NULL);
+    sceKernelStartThread(self->iconThread, 0, NULL);
+}
