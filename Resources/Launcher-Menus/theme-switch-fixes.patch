+
+void Browser::swapTheme(const char* path){
+    // Everything holding a pointer to the current theme's images or sound must
+    // let go of it before the theme is freed, otherwise it is used after free.
+    GameManager::stopForThemeChange(); // game entries and the icon/scan thread
+    SystemMgr::pauseDraw();
+    for (int i=0; i<entries->size(); i++){
+        entries->at(i)->freeIcon(); // browser icons may be the theme's NOICON
+    }
+    common::deleteTheme();
+    common::setThemePath((char*)path);
+    common::loadTheme();
+    common::stopLoadingThread();
+    SystemMgr::resumeDraw();
+    GameManager::restartAfterThemeChange();
 }
 
